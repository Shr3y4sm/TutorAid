# TutorAid mobile app — environment template
#
# Copy to .env and fill in, OR set these EXPO_PUBLIC_* vars in your
# EAS build profile. In a plain `expo start` session these are NOT loaded
# (babel-preset-expo has no dotenv) — the effective values then fall back to
# the "extra" block in app.json. ALWAYS override for production builds.
#
# The app is configured to work out-of-the-box against the dev Supabase
# project via the app.json fallback, so you only strictly need these once you
# build for staging/production.

# Base URL of the TutorAid REST API
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Supabase (mobile uses the ANON key, not the service-role key)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# WebSocket URL of the WebRTC signalling server (default ws://localhost:8080/ws)
EXPO_PUBLIC_SIGNALING_URL=ws://localhost:8080/ws

# Optional TURN relay servers as a JSON array (recommended for production
# NAT traversal beyond a LAN). Example:
# EXPO_PUBLIC_TURN_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]