# TutorAid Signalling Server — environment configuration
# Copy this file to ".env" and adjust values, then run: npm start

# HTTP port (for /health and /stats endpoints)
PORT=4000

# WebSocket port
WS_PORT=8080

# WebSocket URL path — clients must connect to ws(s)://host:WS_PORT<WS_PATH>
WS_PATH=/ws

# CORS origin allow-list (comma-separated).
# Use "*" to allow all origins (NOT recommended for production).
# Example: CORS_ORIGINS=https://your-app.com,https://www.your-app.com
CORS_ORIGINS=*

# TLS (WSS) — uncomment and set paths to serve over secure WebSocket.
# Required for production (browsers need HTTPS/WSS for getUserMedia).
# TLS_KEY_PATH=/etc/ssl/private/key.pem
# TLS_CERT_PATH=/etc/ssl/certs/cert.pem
