# TutorAid REST API — environment template
#
# The backend authenticates Supabase JWTs via getUser() and performs all
# database writes with the SERVICE ROLE key. Never ship the service-role
# key to mobile clients — it lives only here (server-side).

PORT=3000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key