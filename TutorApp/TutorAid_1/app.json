{
  "expo": {
    "name": "TutorAid",
    "slug": "TutorAid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tutoraid",
    "userInterfaceStyle": "automatic",
    "extra": {
      "signalingUrl": "ws://localhost:8080/ws"
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "TutorAid needs camera access for video calling.",
        "NSMicrophoneUsageDescription": "TutorAid needs microphone access for audio in video calls.",
        "NSBluetoothAlwaysUsageDescription": "TutorAid uses Bluetooth to discover nearby devices for video calls."
      }
    },
    "android": {
      "permissions": ["CAMERA", "RECORD_AUDIO", "INTERNET"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.TutorAid",
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
