{
  "cli": {
    "version": ">= 20.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "preview-video-boot": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.yourdomain.com",
        "EXPO_PUBLIC_SIGNALING_URL": "wss://signal.yourdomain.com:8443/ws",
        "EXPO_PUBLIC_TURN_SERVERS": "PLACEHOLDER"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
